# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
SERVICE_NAME=eventflow-user-service
LOG_LEVEL=info

# ── MongoDB ───────────────────────────────────────────────────────────────────
# For local development:
MONGODB_URI=mongodb://localhost:27017/eventflow_users
# For Docker Compose (replace credentials as needed):
# MONGODB_URI=mongodb://admin:adminpassword@mongodb:27017/eventflow_users?authSource=admin

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword
MONGO_DB_NAME=eventflow_users

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL (used to restrict CORS)
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
